    "Once per window, when a limit runs 15 points ahead of a steady pace to its reset." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Einmal pro Zeitraum, wenn ein Limit 15 Punkte über einem gleichmäßigen Tempo bis zum Zurücksetzen liegt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una vez por periodo, cuando un límite va 15 puntos por delante de un ritmo parejo hasta su reinicio."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une fois par période, quand une limite a 15 points d'avance sur un rythme régulier jusqu'à sa réinitialisation."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "期間ごとに1回、上限がリセットまでの均等なペースより15ポイント先行したとき。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "기간마다 한 번, 한도가 초기화까지 고른 페이스보다 15포인트 앞서면 알려줍니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",

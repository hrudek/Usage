        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "한도를 모두 쓰면 알려주고, 크레딧이 대신 쓰이는지도 알려줍니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {

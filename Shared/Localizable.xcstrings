    "When a limit runs out, and whether credits take over." : {
      "comment" : "Line under the Limit reached toggle.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn ein Limit aufgebraucht ist, und ob Credits einspringen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuando un límite se agota, y si los créditos toman el relevo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quand une limite est épuisée, et si les crédits prennent le relais."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "上限に達したとき。クレジットに切り替わるかどうかもお知らせします。"

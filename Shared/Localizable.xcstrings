    "Equivalent cost at Anthropic's list prices as of %@. Your subscription already covers this usage, so this is not a bill. Read from %@." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Entsprechende Kosten zu den Listenpreisen von Anthropic vom %1$@. Dein Abo deckt diese Nutzung bereits ab, das ist also keine Rechnung. Gelesen aus %2$@."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Coste equivalente a los precios de lista de Anthropic a fecha de %1$@. Tu suscripción ya cubre este uso: no es una factura. Leído de %2$@."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Coût équivalent aux tarifs publics d'Anthropic au %1$@. Votre abonnement couvre déjà cet usage, ce n'est donc pas une facture. Lu depuis %2$@."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@時点のAnthropic定価での換算コストです。この使用量はサブスクリプションに含まれており、請求ではありません。%2$@から読み取りました。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ 기준 Anthropic 정가로 환산한 비용입니다. 이 사용량은 구독에 이미 포함되어 있으며 청구서가 아닙니다. %2$@에서 읽음."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Custo equivalente aos preços de tabela da Anthropic em %1$@. Sua assinatura já cobre este uso, então não é uma cobrança. Lido de %2$@."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "按 %1$@ 的 Anthropic 标价折算的等效费用。你的订阅已包含这些用量，这不是账单。读取自 %2$@。"
          }
        }
      }
    },

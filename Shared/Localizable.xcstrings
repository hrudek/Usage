    "At %lld%%, %lld points ahead of a steady pace to its reset." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bei %1$lld%%, %2$lld Punkte über einem gleichmäßigen Tempo bis zum Zurücksetzen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Va en %1$lld%%, %2$lld puntos por delante de un ritmo parejo hasta su reinicio."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "À %1$lld %%, %2$lld points d'avance sur un rythme régulier jusqu'à la réinitialisation."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$lld%%で、リセットまでの均等なペースより%2$lldポイント先行しています。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$lld%%로, 초기화까지 고른 페이스보다 %2$lld포인트 앞서 있습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Em %1$lld%%, %2$lld pontos à frente de um ritmo constante até reiniciar."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",

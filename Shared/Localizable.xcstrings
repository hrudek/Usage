    "%@ rejected Usage's saved sign-in. Open Usage and sign in again to keep tracking your usage." : {
      "comment" : "Body of the sign-in expired notification. The placeholder is the service's name (Claude, Codex, GitHub Copilot).",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ hat die gespeicherte Anmeldung von Usage abgelehnt. Öffne Usage und melde dich erneut an, um deine Nutzung weiter zu verfolgen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ rechazó el inicio de sesión guardado de Usage. Abre Usage y vuelve a iniciar sesión para seguir midiendo tu uso."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ a refusé la connexion enregistrée d'Usage. Ouvrez Usage et reconnectez-vous pour continuer à suivre votre usage."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@がUsageの保存済みサインインを拒否しました。使用量の記録を続けるにはUsageを開いてもう一度サインインしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@에서 Usage의 저장된 로그인을 거부했습니다. 사용량 추적을 계속하려면 Usage를 열고 다시 로그인하세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ rejeitou o login salvo do Usage. Abra o Usage e entre de novo para continuar acompanhando seu uso."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 拒绝了 Usage 保存的登录。打开 Usage 并重新登录以继续跟踪用量。"
          }
        }
      }
    },

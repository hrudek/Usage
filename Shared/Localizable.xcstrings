    "Each one is the sign-in flow the provider's own tools use; Usage only receives the token the provider hands back." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jeder davon ist der Anmeldeablauf, den die eigenen Werkzeuge des Anbieters verwenden; Usage erhält nur das Token, das der Anbieter zurückgibt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada uno es el flujo de inicio de sesión que usan las propias herramientas del proveedor; Usage solo recibe el token que el proveedor devuelve."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chacun est le parcours de connexion qu'utilisent les propres outils du fournisseur ; Usage ne reçoit que le jeton que le fournisseur renvoie."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "いずれも各プロバイダ自身のツールが使うサインインの流れで、Usage が受け取るのはプロバイダが返すトークンだけです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "각각은 제공업체 자체 도구가 쓰는 로그인 절차이며, Usage는 제공업체가 돌려주는 토큰만 받습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada um é o fluxo de login que as próprias ferramentas do provedor usam; o Usage só recebe o token que o provedor devolve."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每一种都是提供方自家工具所用的登录流程；Usage 只接收提供方返回的令牌。"
          }
        }
      }
    },
